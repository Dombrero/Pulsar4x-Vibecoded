                  },
                  "ComponentType": "Sensor",
                  "MountType": 19,
                  "IndustryTypeID": "component-construction",
                  "CargoTypeID": "general-storage",
                  "Properties": [
                    {
                      "$id": "55",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Antenna Size",
                      "DescriptionFormula": "'Gives an effective area of:  '",
                      "Units": "m^2",
                      "GuiHint": 8,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "56",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": "2500",
                      "MinFormula": "1",
                      "StepFormula": "1",
                      "PropertyFormula": "1.25",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "57",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Effective Size",
                      "DescriptionFormula": null,
                      "Units": "m^2",
                      "GuiHint": 1,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "58",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "PropertyValue('Antenna Size') * TechData('tech-antenna-efficiency')",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "59",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Ideal Detection Wavelength",
                      "DescriptionFormula": "'The wavelength this sensor is most efficient at detecting'",
                      "Units": "nm",
                      "GuiHint": 8,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "60",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": "1e12",
                      "MinFormula": "0.01",
                      "StepFormula": "1",
                      "PropertyFormula": "600",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "61",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Detection Bandwidth",
                      "DescriptionFormula": "'How far from the ideal wavelength will this still detect a signal'",
                      "Units": "nm",
                      "GuiHint": 8,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "62",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": "TechData('tech-antenna-bandwidth')",
                      "MinFormula": "1",
                      "StepFormula": "1",
                      "PropertyFormula": "250",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "63",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Efficiency",
                      "DescriptionFormula": null,
                      "Units": null,
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "64",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "1 / (PropertyValue('Detection Bandwidth') / TechData('tech-antenna-bandwidth') )",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "65",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Sensitivity at Ideal Wavelength",
                      "DescriptionFormula": "'Smallest signal this can detect at the ideal wavelength, lower is better.",
                      "Units": "W",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "66",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "TechData('tech-antenna-sensitivity') / (PropertyValue('Effective Size') * PropertyValue('Effective Size') * PropertyValue('Efficiency'))",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "67",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Sensitivity at Worst Wavelength",
                      "DescriptionFormula": "'Smallest signal this can detect at the worst wavelength, lower is better.'",
                      "Units": "W",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "68",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "TechData('tech-antenna-sensitivity') / (PropertyValue('Effective Size') * PropertyValue('Effective Size') * PropertyValue('Efficiency') * 0.1)",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "69",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Resolution",
                      "DescriptionFormula": "'How much detail it can get from a detection. affects likelyhood of component detection etc. '",
                      "Units": "MegaPixel",
                      "GuiHint": 8,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
