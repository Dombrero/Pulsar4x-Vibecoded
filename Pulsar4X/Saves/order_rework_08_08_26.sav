                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "genericBeamWpnAtbArgs",
                      "DescriptionFormula": "'int range, double wavelength, int wattage",
                      "Units": null,
