              "LockedTechs": {
                "$id": "768",
                "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[Pulsar4X.Technology.Tech, GameEngine]], System.Private.CoreLib",
                "tech-infra-gravity-range": {
                  "$id": "769",
                  "$type": "Pulsar4X.Technology.Tech, GameEngine",
                  "Design": null,
                  "Faction": {
