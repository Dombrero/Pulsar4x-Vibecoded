                    "FactionOwnerID": 0
                  },
                  "Level": 0,
                  "ResearchProgress": 0,
                  "ResearchCost": 1500,
                  "Name": "Habitat Gravity Tolerance",
                  "Description": "Reinforces structural and life-support systems so that infrastructure can be designed for a wider band of surface gravity around Earth-normal (9.81 m/s²). Each level extends the design's allowed half-width by ~0.49 m/s² (5% of Earth gravity), from ±0.98 m/s² at L0 to ±2.45 m/s² at L3.",
                  "MaxLevel": 3,
                  "CostFormula": "1500 + [Level] * 1500",
                  "DataFormula": "0.1 + [Level] * 0.05",
                  "Category": "tech-category-biology-genetics",
                  "Unlocks": {
                    "$id": "771",
                    "$type": "System.Collections.Generic.Dictionary`2[[System.Int32, System.Private.CoreLib],[System.Collections.Generic.List`1[[System.String, System.Private.CoreLib]], System.Private.CoreLib]], System.Private.CoreLib"
                  },
                  "UniqueID": "tech-infra-gravity-range"
                },
                "tech-infra-gravity-min-extension": {
                  "$id": "772",
                  "$type": "Pulsar4X.Technology.Tech, GameEngine",
                  "Design": null,
                  "Faction": {
                    "$ref": "770"
                  },
                  "Level": 0,
                  "ResearchProgress": 0,
                  "ResearchCost": 1000,
                  "Name": "Low-Gravity Habitat Engineering",
                  "Description": "Permits infrastructure to function on low-gravity bodies — asteroids, comets, and small moons — far below the band general tolerance research alone allows. Each of the 5 levels lowers the achievable minimum by an additional ~1.96 m/s² (20% of Earth gravity), reaching 0 m/s² at the highest level.",
                  "MaxLevel": 5,
                  "CostFormula": "1000 + [Level] * 1000",
                  "DataFormula": "[Level] * 0.2",
                  "Category": "tech-category-biology-genetics",
                  "Unlocks": {
                    "$id": "773",
                    "$type": "System.Collections.Generic.Dictionary`2[[System.Int32, System.Private.CoreLib],[System.Collections.Generic.List`1[[System.String, System.Private.CoreLib]], System.Private.CoreLib]], System.Private.CoreLib"
                  },
                  "UniqueID": "tech-infra-gravity-min-extension"
                },
                "tech-infra-gravity-max-extension": {
                  "$id": "774",
                  "$type": "Pulsar4X.Technology.Tech, GameEngine",
                  "Design": null,
                  "Faction": {
                    "$ref": "770"
                  },
                  "Level": 0,
                  "ResearchProgress": 0,
                  "ResearchCost": 2000,
                  "Name": "High-Gravity Habitat Engineering",
                  "Description": "Permits infrastructure to function on heavy worlds far beyond the band general tolerance research alone allows. The 5 levels follow a phased curve — early levels add modest headroom, later levels unlock dramatic gains, reaching ~100 m/s² at the highest level. Per-level deltas (m/s²): +3.5, +10.5, +17.6, +24.6, +31.6.",
                  "MaxLevel": 5,
                  "CostFormula": "2000 + [Level] * [Level] * 1500",
                  "DataFormula": "[Level] * [Level] * 0.36",
                  "Category": "tech-category-biology-genetics",
                  "Unlocks": {
                    "$id": "775",
                    "$type": "System.Collections.Generic.Dictionary`2[[System.Int32, System.Private.CoreLib],[System.Collections.Generic.List`1[[System.String, System.Private.CoreLib]], System.Private.CoreLib]], System.Private.CoreLib"
                  },
                  "UniqueID": "tech-infra-gravity-max-extension"
                },
