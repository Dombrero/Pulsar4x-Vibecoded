                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "1.5 * (PropertyValue('Size') * 0.5 - PropertyValue('Size') * 0.5 * PropertyValue('Rate vs Range') * 0.1)",
