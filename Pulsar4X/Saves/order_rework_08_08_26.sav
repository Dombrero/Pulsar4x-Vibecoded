                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "721",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Input Light",
                      "DescriptionFormula": "'Energy out put of a laser pulse'",
                      "Units": "W",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "722",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "PropertyValue('Conversion Efficency') * PropertyValue('Power Input')",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "723",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Chamber Absorption",
                      "DescriptionFormula": "'What percentage of stored light in the chamber is lost as heat (tech)'",
                      "Units": "%",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "724",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "(PropertyValue('Input Light') / (PropertyValue('Chamber Volume') * PropertyValue('Target Wavelength')))",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "725",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Conversion Efficency",
                      "DescriptionFormula": "'What percentage of input energy gets converted into light (tech)'",
                      "Units": "%",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "726",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "Sqrt( PropertyValue('Target Wavelength') / 1000 )",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "727",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Lense Emission",
                      "DescriptionFormula": "'What percentage of stored light is fired (tech)'",
                      "Units": "%",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "728",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "Sqrt( PropertyValue('Duty Cycle') )",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "729",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Pulse Energy",
                      "DescriptionFormula": "'Energy output of a laser pulse'",
                      "Units": "J",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "730",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "PropertyValue('Lense Emission') * (PropertyValue('Input Light') - PropertyValue('Input Light') * Exp(PropertyValue('Chamber Absorption') * -1 * PropertyValue('Charge Period'))) / PropertyValue('Chamber Absorption')",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "731",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Thermal Output",
                      "DescriptionFormula": "'Waste Thermal heat output by laser'",
                      "Units": "W",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "732",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "(PropertyValue('Power Input') * PropertyValue('Charge Period') - PropertyValue('Pulse Energy')) / PropertyValue('Charge Period')",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "733",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "Beam waist",
                      "DescriptionFormula": "'Width of beam at focal length (debug)'",
                      "Units": "M",
                      "GuiHint": 16,
                      "GuiIsEnabledFormula": null,
                      "DataDict": {
                        "$id": "734",
                        "$type": "System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib"
                      },
                      "EnumTypeName": null,
                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": " PropertyValue('Operating Temprature') * PropertyValue('Operating Temprature') * PropertyValue('Focal Length') * 0.000000001 * PropertyValue('Target Wavelength') * ( 1 / PropertyValue('Lens Diameter') ) ",
                      "AttributeType": null,
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
                      "$id": "735",
                      "$type": "Pulsar4X.Blueprints.ComponentTemplatePropertyBlueprint, GameEngine",
                      "Name": "genericWpnAtbArgs",
                      "DescriptionFormula": "'int magSize, int reloadPerSec, int amountPerShot, int minShotsPerfire\nAtbConstrArgs(PropertyValue('Charge Period') * PropertyValue('Power Input'), PropertyValue('Power Input'), PropertyValue('Pulse Energy'), 1)",
                      "Units": null,
