                  "Level": 0,
                  "ResearchProgress": 0,
                  "ResearchCost": 1000,
                  "Name": "Thin-Atmosphere Habitat Engineering",
                  "Description": "Lets infrastructure operate in near-vacuum atmospheres below what general tolerance research alone allows. Each level lowers the achievable minimum by an additional 0.05 (up to 0.25 below the standard floor).",
                  "MaxLevel": 5,
                  "CostFormula": "1000 + [Level] * 1000",
                  "DataFormula": "[Level] * 0.05",
                  "Category": "tech-category-biology-genetics",
                  "Unlocks": {
