                      "MaxFormula": null,
                      "MinFormula": null,
                      "StepFormula": null,
                      "PropertyFormula": "AtbConstrArgs(2, 1, 2, 2)",
                      "AttributeType": "Pulsar4X.Weapons.GenericWeaponAtb",
                      "PairedPropertyName": null,
                      "MaxRangeFormula": null
                    },
                    {
